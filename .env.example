# MK BLACK FRIDAY RADAR - Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real API keys to git

# =====================================================
# FIREWORKS AI - Primary LLM (Kimi K2.5 Turbo)
# Model: accounts/fireworks/routers/kimi-k2p5-turbo
# Base URL: https://api.fireworks.ai/inference/v1
# Get API key from: https://fireworks.ai/account/api-keys
# =====================================================
FIREWORKS_API_KEY=your_fireworks_api_key_here

# =====================================================
# OLLAMA (Optional - for local fallback)
# =====================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =====================================================
# DATABASE - PostgreSQL with PostGIS
# =====================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mkbf_deals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mkbf_deals

# =====================================================
# REDIS - Cache and Queue
# =====================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# =====================================================
# CHROMADB - Vector Database for RAG
# =====================================================
CHROMA_DB_PATH=/root/mk-black-friday-radar/rag/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001

# =====================================================
# JWT Authentication
# =====================================================
JWT_SECRET=your-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =====================================================
# NEXTAUTH (for web frontend)
# =====================================================
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# =====================================================
# POSTHOG ANALYTICS
# Sign up at: https://posthog.com
# =====================================================
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=your_project_id
POSTHOG_PERSONAL_API_KEY=your_personal_api_key

# =====================================================
# MAPBOX - Maps Integration
# Get token from: https://account.mapbox.com/access-tokens
# =====================================================
MAPBOX_API_KEY=your_mapbox_api_key

# =====================================================
# SENTRY - Error Tracking
# Sign up at: https://sentry.io
# =====================================================
SENTRY_DSN=your_sentry_dsn
SENTRY_ORG_TOKEN=your_org_token
SENTRY_PERSONAL_TOKEN=your_personal_token

# =====================================================
# CLOUDFLARE - R2 Storage and CDN
# Account settings: https://dash.cloudflare.com
# =====================================================
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_S3_ENDPOINT=your_r2_endpoint
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=mkbf-assets

# =====================================================
# FIREBASE CLOUD MESSAGING (Push Notifications)
# =====================================================
FIREBASE_PROJECT_ID=mk-black-friday-radar
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id

# =====================================================
# SMTP (Email Notifications)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# =====================================================
# APPLICATION SETTINGS
# =====================================================
APP_NAME="MK Black Friday Radar"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# =====================================================
# SCRAPING SETTINGS
# =====================================================
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=60
USER_AGENT="MK-Black-Friday-Radar/1.0"

# =====================================================
# RATE LIMITING
# =====================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# =====================================================
# MONITORING
# =====================================================
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_ADMIN_PASSWORD=admin

# =====================================================
# DEPLOYMENT
# =====================================================
# Vercel Frontend URL
NEXT_PUBLIC_API_URL=https://your-api-domain.com
VERCEL_TOKEN=your_vercel_token
