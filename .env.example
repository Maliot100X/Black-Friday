# MK BLACK FRIDAY RADAR - Environment Configuration

# API Keys
FIREWORKS_API_KEY=your_fireworks_api_key
OPENAI_API_KEY=your_openai_api_key_optional

# Ollama Configuration (for local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mkbf_deals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mkbf_deals

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB
CHROMA_DB_PATH=/root/mk-black-friday-radar/rag/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NextAuth (for web frontend)
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# PostHog Analytics
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://app.posthog.com

# Firebase Cloud Messaging (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_SERVER_KEY=your_firebase_server_key
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID=your_firebase_app_id

# Mapbox API (for maps)
MAPBOX_API_KEY=your_mapbox_api_key

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn

# Prometheus & Grafana
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_ADMIN_PASSWORD=admin

# SMTP (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Application Settings
APP_NAME="MK Black Friday Radar"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Scraping Settings
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=60
USER_AGENT="MK-Black-Friday-Radar/1.0"

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
